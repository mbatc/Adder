
let test_first: int64 = 0;
let test_second: int64 = 0;

fn return_first(val1: int64, val2: int64) => int64 {
  return val1;
}

fn return_second(val1: int64, val2: int64) => int64 {
  return val2;
}

fn main() => void {
  const a: int64 = 2;
  const b: int64 = 3;

  test_second = return_second(a + b, b + 10);
  test_first = return_first(a + b, b);
}
